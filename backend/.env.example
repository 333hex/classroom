# Class Connect Backend Environment Variables
# Copy this file to .env and fill in real values

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string from Supabase (use transaction pooler for Render)
DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=class-connect-files

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# ─── Upload limits ────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Requests per minute for sensitive endpoints
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_DELETE=5/minute
RATE_LIMIT_DOWNLOAD=60/minute

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production

# ─── Signed URL TTL ───────────────────────────────────────────────────────────
# Seconds until a signed download URL expires
SIGNED_URL_TTL_SECONDS=300
